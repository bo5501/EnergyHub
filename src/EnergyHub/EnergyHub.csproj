<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DSPEnergyHub</AssemblyName>
    <RootNamespace>EnergyHub</RootNamespace>
    <Version>1.0.0</Version>
    <Company>EnergyHub</Company>
    <Product>Interstellar Energy Hub</Product>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 部署/发布只留 DSPEnergyHub.dll，不再产 .pdb。
         Debug 配置仍保留符号，方便本地附加调试。 -->
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <DebugType Condition="'$(Configuration)'!='Release'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
    <NoWarn>CS0436;CS0618;CS0649;CS0169</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 游戏程序集：默认值可在命令行覆盖，例如
       dotnet build -p:GameDir="D:\Steam\steamapps\common\Dyson Sphere Program" -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)'==''">D:\Program Files (x86)\Steam\steamapps\common\Dyson Sphere Program</GameDir>
    <!-- 引用来源优先级：
         1. 命令行 -p:ManagedDir=...
         2. 游戏安装目录 $(GameDir)\DSPGAME_Data\Managed
         3. 仓库内 .buildref\Managed（本机没装游戏时的离线编译引用，见 build.sh） -->
    <ManagedDir Condition="'$(ManagedDir)'=='' AND Exists('$(GameDir)\DSPGAME_Data\Managed\Assembly-CSharp.dll')">$(GameDir)\DSPGAME_Data\Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)'=='' AND Exists('$(MSBuildProjectDirectory)\..\..\.buildref\Managed\Assembly-CSharp.dll')">$(MSBuildProjectDirectory)\..\..\.buildref\Managed</ManagedDir>
    <!-- r2modman profile（BepInEx / Harmony / CommonAPI / LDBTool / DSPModSave 的引用来源） -->
    <ProfileDir Condition="'$(ProfileDir)'==''">$(APPDATA)\r2modmanPlus-local\DysonSphereProgram\profiles\chuangshi-lianji\BepInEx</ProfileDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(ProfileDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ProfileDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommonAPI">
      <HintPath>$(ProfileDir)\plugins\CommonAPI-CommonAPI\CommonAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LDBTool">
      <HintPath>$(ProfileDir)\plugins\xiaoye97-LDBTool\LDBTool.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DSPModSave">
      <HintPath>$(ProfileDir)\plugins\CommonAPI-DSPModSave\DSPModSave.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- 联机：Nebula 官方 API（和创世之书同款）。
         只编译期引用，ExcludeAssets=runtime 保证 NebulaAPI.dll 不会被拷进发布包 ——
         玩家从 Thunderstore 装本模组时会自动带上 NebulaMultiplayerModApi 依赖包。 -->
    <PackageReference Include="DysonSphereProgram.Modding.NebulaMultiplayerModApi" Version="2.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- AI 使用披露（Thunderstore 合规）：写进程序集元数据，审核与用户都能直接查
       （readelf 之外的常规做法：Assembly-CSharp 内嵌 AssemblyMetadataAttribute）。
       1.16.2 起。 -->
  <ItemGroup>
    <AssemblyMetadata Include="AI_Assisted_Creation" Value="true" />
    <AssemblyMetadata Include="AI_Model_Vendor" Value="DeepSeek" />
    <AssemblyMetadata Include="AI_Disclosure" Value="Code, docs and textures generated with generative AI assistance; author directed design, tested and published." />
  </ItemGroup>


</Project>
